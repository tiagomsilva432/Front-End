+import { useTheme } from "../../theme/tema";
+import { ESTADOS_PROJETO, formatarData, formatarEuros, idDe } from "../../utils/formatar";
+import Icone from "../ui/Icone";
+
+export default function ListaProjetos({ projetos, carregando, onNovo }) {
+  const tema = useTheme();
+
+  return (
+    <div className="space-y-6">
+      <div className="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
+        <div>
+          <h1 className="text-2xl font-bold">Projetos</h1>
+          <p className={`mt-1 text-xs ${tema.muted}`}>As alocações gerem-se a partir do diretório de colaboradores.</p>
+        </div>
+        <button
+          type="button"
+          onClick={onNovo}
+          className={`flex items-center gap-2 rounded-xl px-4 py-2.5 text-xs font-bold shadow-md transition ${tema.primaryBtn}`}
+        >
+          <Icone nome="mais" className="h-4 w-4" />
+          Novo projeto
+        </button>
+      </div>
+
+      {carregando || projetos.length === 0 ? (
+        <div className={`rounded-2xl border p-12 text-center text-xs ${tema.card} ${tema.muted}`}>
+          {carregando ? "A carregar projetos…" : "Ainda não há projetos registados."}
+        </div>
+      ) : (
+        <div className="grid grid-cols-1 gap-5 md:grid-cols-2">
+          {projetos.map((proj) => (
+            <article key={idDe(proj)} className={`space-y-4 rounded-2xl border p-6 ${tema.card}`}>
+              <div className="flex items-start justify-between gap-3">
+                <h3 className="min-w-0 break-words text-base font-bold">{proj.name}</h3>
+                <span className={`shrink-0 rounded border px-2.5 py-1 text-[10px] font-bold ${tema.active}`}>
+                  {ESTADOS_PROJETO[proj.status] || proj.status || "—"}
+                </span>
+              </div>
+              <dl className={`space-y-1 text-xs ${tema.muted}`}>
+                <div className="flex gap-1">
+                  <dt>Cliente:</dt>
+                  <dd className={tema.strong}>{proj.clientName || "—"}</dd>
+                </div>
+                <div className="flex gap-1">
+                  <dt>Início:</dt>
+                  <dd className={tema.strong}>{formatarData(proj.startDate, "—")}</dd>
+                </div>
+                <div className="flex gap-1">
+                  <dt>Orçamento:</dt>
+                  <dd className={`font-semibold ${tema.accent}`}>{formatarEuros(proj.budget)}</dd>
+                </div>
+              </dl>
+            </article>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/empresa/ModalAlocacoes.jsx b/src/components/empresa/ModalAlocacoes.jsx
new file mode 100644
index 0000000..008d7f9
--- /dev/null
+++ b/src/components/empresa/ModalAlocacoes.jsx
@@ -0,0 +1,243 @@
+import { useEffect, useState } from "react";
+import { criarAlocacao, listarAlocacoesUser, obterCargaAlocacao } from "../../services/allocationservice";
+import { useTheme } from "../../theme/tema";
+import { formatarData, hojeISO, idDe, nomeCompleto } from "../../utils/formatar";
+import Alerta from "../ui/Alerta";
+import Campo from "../ui/Campo";
+import Modal from "../ui/Modal";
+
+const alocacaoVazia = () => ({
+  projectId: "",
+  allocationPercent: "100",
+  roleOnProject: "",
+  startDate: hojeISO(),
+  endDate: "",
+});
+
+export default function ModalAlocacoes({ colaborador, projetos, token, onFechar }) {
+  const tema = useTheme();
+  const [alocacoes, setAlocacoes] = useState([]);
+  const [carga, setCarga] = useState(null);
+  const [carregando, setCarregando] = useState(true);
+  const [recarga, setRecarga] = useState(0);
+  const [aGuardar, setAGuardar] = useState(false);
+  const [erro, setErro] = useState("");
+  const [sucesso, setSucesso] = useState("");
+  const [nova, setNova] = useState(alocacaoVazia);
+
+  useEffect(() => {
+    let ativo = true;
+    Promise.all([listarAlocacoesUser(colaborador.id, token, true), obterCargaAlocacao(colaborador.id, token)])
+      .then(([lista, cargaAtual]) => {
+        if (!ativo) return;
+        setAlocacoes(Array.isArray(lista) ? lista : []);
+        setCarga(cargaAtual);
+      })
+      .catch((err) => {
+        if (ativo) setErro(err.message || "Não foi possível carregar as alocações.");
+      })
+      .finally(() => {
+        if (ativo) setCarregando(false);
+      });
+    return () => {
+      ativo = false;
+    };
+  }, [colaborador.id, token, recarga]);
+
+  const recarregar = () => {
+    setCarregando(true);
+    setErro("");
+    setRecarga((n) => n + 1);
+  };
+
+  const alterar = (campo) => (e) => setNova((atual) => ({ ...atual, [campo]: e.target.value }));
+
+  const guardar = async (e) => {
+    e.preventDefault();
+    setAGuardar(true);
+    setErro("");
+    setSucesso("");
+    try {
+      await criarAlocacao(
+        {
+          userId: colaborador.id,
+          projectId: nova.projectId,
+          allocationPercent: Number(nova.allocationPercent),
+          startDate: nova.startDate,
+          ...(nova.roleOnProject.trim() ? { roleOnProject: nova.roleOnProject.trim() } : {}),
+          ...(nova.endDate ? { endDate: nova.endDate } : {}),
+        },
+        token,
+      );
+      setSucesso("Alocação criada com sucesso.");
+      setNova((atual) => ({ ...atual, projectId: "", roleOnProject: "", endDate: "" }));
+      recarregar();
+    } catch (err) {
+      setErro(err.message || "Não foi possível criar a alocação.");
+    } finally {
+      setAGuardar(false);
+    }
+  };
+
+  const totalAtual = carga?.totalPercent || 0;
+  const percentagemNova = Number(nova.allocationPercent);
+  const vaiSobrealocar = carga?.overAllocated || (percentagemNova > 0 && totalAtual + percentagemNova > 100);
+  const nome = nomeCompleto(colaborador);
+
+  return (
+    <Modal
+      id="alocacoes-colaborador"
+      titulo="Alocações do colaborador"
+      subtitulo={nome ? `${nome} · ${colaborador.email}` : colaborador.email}
+      onFechar={onFechar}
+      bloqueado={aGuardar}
+      largura="max-w-3xl"
+    >
+      <div className="space-y-5">
+        {erro && (
+          <Alerta
+            textoAcao="Tentar novamente"
+            onAcao={!carregando && alocacoes.length === 0 && !sucesso ? recarregar : undefined}
+          >
+            {erro}
+          </Alerta>
+        )}
+        {sucesso && <Alerta tipo="sucesso">{sucesso}</Alerta>}
+
+        <div className={`flex flex-wrap items-center justify-between gap-3 rounded-xl border p-4 ${tema.border} ${tema.cardMuted}`}>
+          <div>
+            <p className={`text-xs ${tema.muted}`}>Carga de alocação atual</p>
+            <p className="mt-1 text-xl font-bold">{carregando ? "…" : `${totalAtual}%`}</p>
+          </div>
+          <button
+            type="button"
+            onClick={recarregar}
+            disabled={carregando}
+            className={`rounded-lg border px-3 py-2 text-xs font-semibold disabled:opacity-50 ${tema.secondaryBtn}`}
+          >
+            {carregando ? "A atualizar…" : "Atualizar"}
+          </button>
+        </div>
+
+        {vaiSobrealocar && (
+          <Alerta tipo="aviso">
+            Com esta alocação, a carga ficará acima de 100%. O sistema permite guardar e sinaliza a sobrealocação.
+          </Alerta>
+        )}
+
+        <div>
+          <h3 className="mb-3 text-sm font-semibold">Projetos atuais</h3>
+          {carregando || alocacoes.length === 0 ? (
+            <p className={`rounded-xl border p-4 text-sm ${tema.border} ${tema.muted}`}>
+              {carregando ? "A carregar alocações…" : "Ainda não há alocações abertas para este colaborador."}
+            </p>
+          ) : (
+            <div className="max-h-52 space-y-2 overflow-y-auto pr-1">
+              {alocacoes.map((alocacao) => {
+                const projeto = projetos.find((item) => idDe(item) === alocacao.projectId);
+                return (
+                  <div
+                    key={alocacao.id}
+                    className={`flex flex-col gap-2 rounded-xl border p-3 sm:flex-row sm:items-center sm:justify-between ${tema.border} ${tema.cardMuted}`}
+                  >
+                    <div className="min-w-0">
+                      <p className="truncate text-sm font-semibold">{projeto?.name || "Projeto"}</p>
+                      <p className={`mt-1 text-xs ${tema.muted}`}>
+                        {alocacao.roleOnProject || "Função não definida"} · Desde {formatarData(alocacao.startDate)}
+                      </p>
+                    </div>
+                    <span className={`shrink-0 rounded-lg border px-2.5 py-1.5 text-sm font-bold ${tema.active}`}>
+                      {alocacao.allocationPercent}%
+                    </span>
+                  </div>
+                );
+              })}
+            </div>
+          )}
+        </div>
+
+        <form onSubmit={guardar} className={`space-y-4 border-t pt-5 ${tema.border}`}>
+          <div>
+            <h3 className="text-sm font-semibold">Nova alocação</h3>
+            <p className={`mt-1 text-xs ${tema.muted}`}>Escolha um projeto e defina a participação e o período.</p>
+          </div>
+          <div className="grid gap-4 sm:grid-cols-2">
+            <Campo
+              id="alocacao-projeto"
+              label="Projeto"
+              obrigatorio
+              como="select"
+              className="sm:col-span-2"
+              value={nova.projectId}
+              onChange={alterar("projectId")}
+              disabled={aGuardar || projetos.length === 0}
+            >
+              <option value="">{projetos.length ? "Selecione um projeto" : "Não há projetos disponíveis"}</option>
+              {projetos.map((projeto) => (
+                <option key={idDe(projeto)} value={idDe(projeto)}>
+                  {projeto.name || "Projeto sem nome"}
+                </option>
+              ))}
+            </Campo>
+            <Campo
+              id="alocacao-percentagem"
+              label="Percentagem (1–100)"
+              obrigatorio
+              type="number"
+              min="1"
+              max="100"
+              step="1"
+              value={nova.allocationPercent}
+              onChange={alterar("allocationPercent")}
+              disabled={aGuardar}
+            />
+            <Campo
+              id="alocacao-funcao"
+              label="Função no projeto"
+              maxLength="100"
+              placeholder="Ex.: Designer"
+              value={nova.roleOnProject}
+              onChange={alterar("roleOnProject")}
+              disabled={aGuardar}
+            />
+            <Campo
+              id="alocacao-inicio"
+              label="Data de início"
+              obrigatorio
+              type="date"
+              value={nova.startDate}
+              onChange={alterar("startDate")}
+              disabled={aGuardar}
+            />
+            <Campo
+              id="alocacao-fim"
+              label="Data de fim (opcional)"
+              type="date"
+              min={nova.startDate}
+              value={nova.endDate}
+              onChange={alterar("endDate")}
+              disabled={aGuardar}
+            />
+          </div>
+          <div className="flex flex-col-reverse gap-2 pt-1 sm:flex-row sm:justify-end">
+            <button
+              type="button"
+              disabled={aGuardar}
+              onClick={onFechar}
+              className={`rounded-xl border px-4 py-2.5 text-sm font-medium ${tema.secondaryBtn}`}
+            >
+              Fechar
+            </button>
+            <button
+              type="submit"
+              disabled={aGuardar || carregando || projetos.length === 0}
+              className={`rounded-xl px-4 py-2.5 text-sm font-semibold disabled:opacity-60 ${tema.primaryBtn}`}
+            >
+              {aGuardar ? "A guardar…" : "Criar alocação"}
+            </button>
+          </div>
+        </form>
+      </div>
+    </Modal>
+  );
+}
diff --git a/src/components/empresa/ModalEditarColaborador.jsx b/src/components/empresa/ModalEditarColaborador.jsx
new file mode 100644
index 0000000..a88d5ab
