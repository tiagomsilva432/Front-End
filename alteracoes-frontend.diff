@@ -0,0 +1,73 @@
+import { useTheme } from "../../theme/tema";
+import { ESTADOS_PROJETO, formatarData } from "../../utils/formatar";
+
+// Lista das alocações do colaborador. `resumida` mostra linhas compactas (visão geral); caso contrário, cartões completos.
+export default function ListaAlocacoes({ alocacoes, carregando, resumida = false }) {
+  const tema = useTheme();
+
+  if (carregando || alocacoes.length === 0) {
+    const texto = carregando ? "A carregar as suas alocações…" : "Não tem alocações abertas neste momento.";
+    return resumida ? (
+      <p className={`text-sm ${tema.muted}`}>{texto}</p>
+    ) : (
+      <div className={`rounded-2xl border p-8 text-center text-sm ${tema.card} ${tema.muted}`}>{texto}</div>
+    );
+  }
+
+  if (resumida) {
+    return (
+      <div className="space-y-3">
+        {alocacoes.map((alocacao) => (
+          <div
+            key={alocacao.id}
+            className={`flex flex-col gap-2 rounded-xl border p-3 sm:flex-row sm:items-center sm:justify-between ${tema.chip}`}
+          >
+            <div className="min-w-0">
+              <p className="truncate text-sm font-semibold">{alocacao.projeto?.name || "Projeto"}</p>
+              <p className={`mt-1 text-xs ${tema.muted}`}>
+                {alocacao.roleOnProject || "Função não definida"} · Desde {formatarData(alocacao.startDate)}
+              </p>
+            </div>
+            <span className={`shrink-0 text-sm font-bold ${tema.accent}`}>{alocacao.allocationPercent}%</span>
+          </div>
+        ))}
+      </div>
+    );
+  }
+
+  return (
+    <div className="grid grid-cols-1 gap-4 xl:grid-cols-2">
+      {alocacoes.map((alocacao) => (
+        <article key={alocacao.id} className={`rounded-2xl border p-5 sm:p-6 ${tema.card}`}>
+          <div className="flex items-start justify-between gap-3">
+            <div className="min-w-0">
+              <h3 className="break-words text-base font-bold">{alocacao.projeto?.name || "Projeto"}</h3>
+              <p className={`mt-1 text-sm ${tema.muted}`}>{alocacao.projeto?.clientName || "Cliente não indicado"}</p>
+            </div>
+            <span className={`shrink-0 rounded-lg border px-2.5 py-1.5 text-sm font-bold ${tema.active}`}>
+              {alocacao.allocationPercent}%
+            </span>
+          </div>
+          <dl className={`mt-5 grid grid-cols-1 gap-3 border-t pt-4 text-sm sm:grid-cols-2 ${tema.border}`}>
+            <div>
+              <dt className={`text-xs ${tema.muted}`}>Função</dt>
+              <dd className="mt-1">{alocacao.roleOnProject || "Não definida"}</dd>
+            </div>
+            <div>
+              <dt className={`text-xs ${tema.muted}`}>Início da alocação</dt>
+              <dd className="mt-1">{formatarData(alocacao.startDate)}</dd>
+            </div>
+            <div>
+              <dt className={`text-xs ${tema.muted}`}>Estado do projeto</dt>
+              <dd className="mt-1">{ESTADOS_PROJETO[alocacao.projeto?.status] || alocacao.projeto?.status || "Não disponível"}</dd>
+            </div>
+            <div>
+              <dt className={`text-xs ${tema.muted}`}>Fim da alocação</dt>
+              <dd className="mt-1">{formatarData(alocacao.endDate, "Sem data prevista")}</dd>
+            </div>
+          </dl>
+        </article>
+      ))}
+    </div>
+  );
+}
diff --git a/src/components/empresa/FormNovoColaborador.jsx b/src/components/empresa/FormNovoColaborador.jsx
new file mode 100644
index 0000000..2d57af6
--- /dev/null
+++ b/src/components/empresa/FormNovoColaborador.jsx
@@ -0,0 +1,114 @@
+import { useState } from "react";
+import { authService } from "../../services/authservice";
+import { useTheme } from "../../theme/tema";
+import Alerta from "../ui/Alerta";
+import Campo from "../ui/Campo";
+
+export default function FormNovoColaborador({ companyId, onRegistroSucesso }) {
+  const tema = useTheme();
+  const [email, setEmail] = useState("");
+  const [firstName, setFirstName] = useState("");
+  const [lastName, setLastName] = useState("");
+  const [loading, setLoading] = useState(false);
+  const [erro, setErro] = useState("");
+  const [sucesso, setSucesso] = useState("");
+
+  const handleSubmit = async (e) => {
+    e.preventDefault();
+    setErro("");
+    setSucesso("");
+
+    if (!companyId) {
+      setErro("Não foi possível identificar a empresa da sessão.");
+      return;
+    }
+
+    if (!firstName.trim() || !lastName.trim()) {
+      setErro("Preencha o primeiro e o último nome do colaborador.");
+      return;
+    }
+
+    try {
+      setLoading(true);
+      await authService.registrar({
+        companyId,
+        email: email.trim(),
+        role: "employee",
+        profile: {
+          firstName: firstName.trim(),
+          lastName: lastName.trim(),
+        },
+      });
+
+      setSucesso("Conta criada com sucesso! O convite foi enviado por e-mail.");
+      setEmail("");
+      setFirstName("");
+      setLastName("");
+
+      if (onRegistroSucesso) {
+        setTimeout(onRegistroSucesso, 1500);
+      }
+    } catch (err) {
+      setErro(err.message || "Ocorreu um erro ao comunicar com o servidor.");
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div className={`mx-auto max-w-xl space-y-6 rounded-2xl border p-6 sm:p-8 ${tema.card}`}>
+      <div>
+        <h2 className="text-xl font-bold">Criar nova conta na empresa</h2>
+        <p className={`mt-1 text-xs ${tema.muted}`}>
+          Insira o nome e o e-mail do novo colaborador para enviar o convite. A conta é criada com o cargo de colaborador.
+        </p>
+      </div>
+
+      {erro && <Alerta tipo="erro">{erro}</Alerta>}
+      {sucesso && <Alerta tipo="sucesso">{sucesso}</Alerta>}
+
+      <form onSubmit={handleSubmit} className="space-y-4">
+        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
+          <Campo
+            id="novo-colaborador-primeiro-nome"
+            label="Primeiro nome"
+            obrigatorio
+            maxLength={100}
+            autoComplete="given-name"
+            placeholder="Ex.: Carla"
+            value={firstName}
+            onChange={(e) => setFirstName(e.target.value)}
+          />
+          <Campo
+            id="novo-colaborador-ultimo-nome"
+            label="Último nome"
+            obrigatorio
+            maxLength={100}
+            autoComplete="family-name"
+            placeholder="Ex.: Mendes"
+            value={lastName}
+            onChange={(e) => setLastName(e.target.value)}
+          />
+        </div>
+        <Campo
+          id="novo-colaborador-email"
+          label="E-mail"
+          obrigatorio
+          type="email"
+          autoComplete="email"
+          placeholder="user@exemplo.pt"
+          value={email}
+          onChange={(e) => setEmail(e.target.value)}
+        />
+
+        <button
+          type="submit"
+          disabled={loading}
+          className={`w-full rounded-xl py-3 text-sm font-semibold shadow-lg transition disabled:opacity-50 ${tema.primaryBtn}`}
+        >
+          {loading ? "A criar conta..." : "Criar conta"}
+        </button>
+      </form>
+    </div>
+  );
+}
