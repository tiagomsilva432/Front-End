@@ -0,0 +1,64 @@
+import { useTheme } from "../../theme/tema";
+import { nomeCompleto } from "../../utils/formatar";
+import Icone from "../ui/Icone";
+
+export default function CartaoEmpresa({ empresa, admin, carregandoAdmin, erroAdmin, onVer, onConvidar }) {
+  const tema = useTheme();
+
+  let estadoAdmin;
+  if (carregandoAdmin) {
+    estadoAdmin = <p className={`rounded-xl border px-3 py-2.5 text-center text-xs ${tema.chip}`}>A verificar administrador...</p>;
+  } else if (erroAdmin) {
+    estadoAdmin = (
+      <p role="status" className={`rounded-xl border px-3 py-2.5 text-center text-xs ${tema.aviso}`}>
+        Não foi possível verificar o administrador.
+      </p>
+    );
+  } else if (admin) {
+    estadoAdmin = (
+      <p className={`rounded-xl border px-3 py-2.5 text-center text-xs ${tema.chip}`}>
+        Administrador: <span className={`font-semibold ${tema.accent}`}>{nomeCompleto(admin) || admin.email}</span>
+      </p>
+    );
+  } else {
+    estadoAdmin = (
+      <button
+        type="button"
+        onClick={onConvidar}
+        className={`flex w-full items-center justify-center gap-2 rounded-xl border py-2.5 text-xs font-semibold transition ${tema.secondaryBtn}`}
+      >
+        <Icone nome="mais" className="h-4 w-4" />
+        Convidar administrador
+      </button>
+    );
+  }
+
+  return (
+    <article className={`flex flex-col justify-between space-y-4 rounded-2xl border p-6 ${tema.card}`}>
+      <div className="space-y-2">
+        <h3 className="min-w-0 break-words text-lg font-bold">{empresa.name}</h3>
+        <p className={`break-all font-mono text-xs ${tema.muted}`}>{empresa.id}</p>
+        <dl className={`space-y-1 pt-2 text-xs ${tema.muted}`}>
+          <div className="flex gap-1">
+            <dt>País:</dt>
+            <dd className={tema.strong}>{empresa.country || "N/D"}</dd>
+          </div>
+          <div className="flex min-w-0 gap-1">
+            <dt>E-mail:</dt>
+            <dd className={`break-all ${tema.strong}`}>{empresa.email || "Não registado"}</dd>
+          </div>
+        </dl>
+      </div>
+      <div className="space-y-2">
+        <button
+          type="button"
+          onClick={onVer}
+          className={`w-full rounded-xl py-2.5 text-xs font-bold shadow-md transition ${tema.primaryBtn}`}
+        >
+          Ver resumo da empresa
+        </button>
+        {estadoAdmin}
+      </div>
+    </article>
+  );
+}
diff --git a/src/components/admin/ModalConvidarAdmin.jsx b/src/components/admin/ModalConvidarAdmin.jsx
new file mode 100644
index 0000000..38f3239
--- /dev/null
+++ b/src/components/admin/ModalConvidarAdmin.jsx
@@ -0,0 +1,105 @@
+import { useState } from "react";
+import { authService } from "../../services/authservice";
+import { useTheme } from "../../theme/tema";
+import Alerta from "../ui/Alerta";
+import Campo from "../ui/Campo";
+import Modal from "../ui/Modal";
+
+export default function ModalConvidarAdmin({ empresa, onFechar, onConvidado }) {
+  const tema = useTheme();
+  const [dados, setDados] = useState({ email: "", firstName: "", lastName: "", jobTitle: "" });
+  const [carregando, setCarregando] = useState(false);
+  const [mensagem, setMensagem] = useState(null);
+
+  const alterar = (campo) => (e) => setDados((atual) => ({ ...atual, [campo]: e.target.value }));
+
+  const handleSubmit = async (e) => {
+    e.preventDefault();
+    setMensagem(null);
+
+    const firstName = dados.firstName.trim();
+    const lastName = dados.lastName.trim();
+    if (Boolean(firstName) !== Boolean(lastName)) {
+      setMensagem({ tipo: "erro", texto: "Preencha o primeiro e o último nome, ou deixe ambos vazios." });
+      return;
+    }
+
+    const profile =
+      firstName && lastName
+        ? { firstName, lastName, ...(dados.jobTitle.trim() ? { jobTitle: dados.jobTitle.trim() } : {}) }
+        : undefined;
+
+    try {
+      setCarregando(true);
+      const resposta = await authService.registrar({
+        email: dados.email.trim(),
+        role: "company_admin",
+        companyId: empresa.id,
+        ...(profile ? { profile } : {}),
+      });
+      onConvidado(resposta?.data || resposta);
+      setMensagem({ tipo: "sucesso", texto: "Convite criado. A conta aguarda ativação pelo administrador." });
+    } catch (err) {
+      setMensagem({ tipo: "erro", texto: err.message || "Não foi possível criar o convite." });
+    } finally {
+      setCarregando(false);
+    }
+  };
+
+  const enviado = mensagem?.tipo === "sucesso";
+
+  return (
+    <Modal
+      id="convidar-admin"
+      titulo="Convidar administrador"
+      subtitulo={
+        <>
+          <span className={`block text-sm ${tema.accent}`}>{empresa.name}</span>
+          Será criada uma conta com o cargo de administrador desta empresa.
+        </>
+      }
+      onFechar={onFechar}
+      bloqueado={carregando}
+      largura="max-w-lg"
+    >
+      {mensagem && (
+        <Alerta tipo={mensagem.tipo} className="mb-4">
+          {mensagem.texto}
+        </Alerta>
+      )}
+
+      {enviado ? (
+        <button type="button" onClick={onFechar} className={`w-full rounded-xl py-3 text-xs font-bold ${tema.primaryBtn}`}>
+          Fechar
+        </button>
+      ) : (
+        <form onSubmit={handleSubmit} className="space-y-4">
+          <Campo
+            id="email-admin"
+            label="E-mail do administrador"
+            obrigatorio
+            type="email"
+            autoComplete="email"
+            placeholder="admin@empresa.com"
+            value={dados.email}
+            onChange={alterar("email")}
+          />
+          <p className={`text-xs ${tema.muted}`}>Nome e cargo são opcionais.</p>
+          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
+            <Campo id="nome-admin" label="Primeiro nome" autoComplete="given-name" value={dados.firstName} onChange={alterar("firstName")} />
+            <Campo id="sobrenome-admin" label="Último nome" autoComplete="family-name" value={dados.lastName} onChange={alterar("lastName")} />
+          </div>
+          <Campo id="cargo-admin" label="Cargo" placeholder="Ex.: Diretor de operações" value={dados.jobTitle} onChange={alterar("jobTitle")} />
+          <div className="flex gap-3 pt-2">
+            <button type="button" onClick={onFechar} disabled={carregando} className={`w-full rounded-xl border py-3 text-xs font-semibold ${tema.secondaryBtn}`}>
+              Cancelar
+            </button>
+            <button type="submit" disabled={carregando} className={`w-full rounded-xl py-3 text-xs font-bold transition disabled:opacity-50 ${tema.primaryBtn}`}>
+              {carregando ? "A enviar convite..." : "Criar convite"}
+            </button>
+          </div>
+        </form>
+      )}
+    </Modal>
+  );
+}
diff --git a/src/components/admin/ModalCriarEmpresa.jsx b/src/components/admin/ModalCriarEmpresa.jsx
