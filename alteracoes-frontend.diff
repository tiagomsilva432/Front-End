+          token={token}
+          onFechar={() => setColaboradorEmEdicao(null)}
+          onGuardado={() => {
+            setColaboradorEmEdicao(null);
+            recarregarDados();
+          }}
+        />
+      )}
+
+      {colaboradorAlocacoes && (
+        <ModalAlocacoes
+          colaborador={colaboradorAlocacoes}
+          projetos={projetos}
+          token={token}
+          onFechar={() => setColaboradorAlocacoes(null)}
+        />
+      )}
+    </PainelLayout>
+  );
+}
